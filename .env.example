# ---------------------------------------------------------------------------
# Landing page configuration
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
# Changing one requires a redeploy, not just an environment update.
# ---------------------------------------------------------------------------

# The deployed marketplace app. When this is set, every primary CTA points at
# it. When it is empty, CTAs fall back to the in-repo /access page and their
# labels change to "Request Beta Access" so the site never promises a product
# the visitor cannot reach.
#
# Must be an absolute https:// URL (http:// is accepted for localhost only).
# An unparseable or non-https value is rejected and treated as "not configured".
NEXT_PUBLIC_APP_URL=

# Canonical public URL of THIS landing page. Used for metadataBase, the
# canonical tag and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=

# A MONITORED support inbox. Leave it empty rather than setting an address
# nobody reads: when unset, every support link degrades to the public GitHub
# issue tracker, which is a destination that actually works. A value that is
# not a valid address is rejected and treated as unset.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Public documentation. Defaults to the GitHub organisation when unset.
NEXT_PUBLIC_DOCS_URL=
